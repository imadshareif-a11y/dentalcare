# نسخ متغيرات البيئة للإنتاج التجريبي — انظر DEPLOY_TRIAL.md
# لا ترفع ملف .env الحقيقي إلى Git

# محلي (بديل لـ DATABASE_URL):
DB_USER=postgres
DB_HOST=localhost
DB_NAME=dentalcare
DB_PASSWORD=postgres
DB_PORT=5432

# إنتاج (Railway / Render): اربط Postgres وضَع
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DB_SSL=true

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

PORT=5000
NODE_ENV=development

# خدمة واجهة Vite من نفس السيرفر (تلقائي عند NODE_ENV=production)
